# Copy to server/.env and fill in. Never commit server/.env. Placeholders only below: no real values.
# In production (NODE_ENV=production) the server refuses to start if any required value is missing or weak.

PORT=5000
NODE_ENV=development

# Exact website origin(s), comma separated. No wildcards. Production origins must be https://
CLIENT_URL=http://localhost:5173

# Leave empty in development to use a built-in in-memory MongoDB (auto-seeded with demo data).
# Production: a MongoDB Atlas connection string for a database user with readWrite on this database only.
MONGO_URI=

# Two different random strings, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cookie SameSite: lax when the website and API share a site (gavyora.com + api.gavyora.com),
# none only if they are on unrelated domains (requires HTTPS).
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the API (Render/Railway/Heroku: 1). Needed for correct client IPs.
TRUST_PROXY=1

# Owner account created on first start of an empty production database. Use a unique password of
# 12+ characters, log in, change it, then remove SUPERADMIN_PASSWORD from the environment.
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PASSWORD=

# Razorpay. Leave all empty to simulate online payments in development (online payment is disabled in production).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional
# BODY_LIMIT=200kb
# BCRYPT_ROUNDS=12
# DEV_ECHO_SECRETS=false   # development only: stop echoing OTPs and reset links in API responses
